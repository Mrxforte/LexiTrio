DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional for local runs; PostgreSQL is recommended for production.
# PostgreSQL (production). Parolni hech qachon repo ichiga yozmang - uni .env faylida saqlang.
DATABASE_URL=postgresql://user:password@localhost:5432/lexitrio

# OpenAI (lug'at tarjimasi). Kalit bo'lmasa /translation/text/ va /document/ 503 qaytaradi.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=90
OPENAI_MAX_RETRIES=2
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_OUTPUT_TOKENS=8192

# Tarjima limitlari
TRANSLATION_MAX_UPLOAD_BYTES=10485760
TRANSLATION_MAX_TEXT_CHARS=20000
TRANSLATION_MAX_SEGMENT_CHARS=2000
TRANSLATION_MAX_SEGMENTS=40
TRANSLATION_BATCH_SIZE=6
TRANSLATION_BACKFILL_REQUIRES_STAFF=true
