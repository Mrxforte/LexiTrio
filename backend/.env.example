# Django core configuration
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Database configuration (PostgreSQL)
POSTGRES_DB=lexitrio
POSTGRES_USER=lexitrio_user
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
DATABASE_URL=postgres://lexitrio_user:replace_with_a_secure_postgres_password@db:5432/lexitrio
DJANGO_CONN_MAX_AGE=60

# Redis & Cache configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Application Server (Gunicorn) Tuning
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Search & Cache TTL settings
DICTIONARY_SEARCH_DEFAULT_PAGE_SIZE=20
DICTIONARY_SEARCH_MAX_PAGE_SIZE=100
DICTIONARY_SEARCH_CACHE_TTL=300
DICTIONARY_VERSION_CACHE_TTL=5
DICTIONARY_SEARCH_PARTIAL_ROWS=200

# OpenAI & Translation API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=90
OPENAI_MAX_RETRIES=2
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_OUTPUT_TOKENS=8192

# Secondary Translation Provider (Optional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
TRANSLATION_CONCURRENCY=1

# Translation limits
TRANSLATION_MAX_UPLOAD_BYTES=10485760
TRANSLATION_MAX_TEXT_CHARS=20000
TRANSLATION_MAX_SEGMENT_CHARS=2000
TRANSLATION_MAX_SEGMENTS=40
TRANSLATION_BATCH_SIZE=6
TRANSLATION_BACKFILL_REQUIRES_STAFF=true
